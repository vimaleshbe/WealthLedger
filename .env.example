# ---------------------------------------------------------------------------
# Copy this file to .env (project root) and set your own credentials.
# The app refuses to start until AUTH_USERNAME and AUTH_PASSWORD are set.
# .env is ignored by Git; never commit real credentials.
# ---------------------------------------------------------------------------

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-long-random-password

# Session lifetime. The session ends after the absolute TTL or the idle
# timeout, whichever comes first.
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_IDLE_MINUTES=60

# Login throttling: failed attempts allowed per client IP within the window.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Secure cookies are required over HTTPS and default to true in production.
# Set to false only if you intentionally serve the app over plain HTTP.
# AUTH_COOKIE_SECURE=true
